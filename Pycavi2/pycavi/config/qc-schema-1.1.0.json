{
  "$schema": "http://stsci.edu/schemas/asdf/asdf-schema-1.1.0",
  "id": "asdf://wenu-imaging/schemas/qc-1.1.0",
  "title": "Shared wenu-imaging QC record (opt-in candidate)",
  "type": "object",
  "properties": {
    "qc": {
      "type": "object",
      "properties": {
        "file": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "raw",
                "product"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              ]
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "selectors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "detector_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hdu_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "configuration_detector": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "table_name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "detector_id"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "hdu_index"
                    ],
                    "not": {
                      "required": [
                        "table_name"
                      ]
                    }
                  },
                  {
                    "required": [
                      "table_name"
                    ],
                    "not": {
                      "required": [
                        "hdu_index"
                      ]
                    }
                  }
                ]
              }
            },
            "context": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "filename",
            "location",
            "kind",
            "sha256",
            "observed_at",
            "selectors"
          ],
          "additionalProperties": false
        },
        "characterization": {
          "type": "object",
          "properties": {
            "detectors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "detector_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "measurements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1
                        },
                        "status": {
                          "enum": [
                            "measured",
                            "unavailable",
                            "invalid"
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "definition": {
                          "type": "object",
                          "properties": {
                            "method": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "stage": {
                              "type": "string",
                              "minLength": 1
                            },
                            "region": {
                              "type": [
                                "object",
                                "null"
                              ]
                            },
                            "sample_count": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 1
                            }
                          },
                          "required": [
                            "method",
                            "stage",
                            "region",
                            "sample_count"
                          ],
                          "additionalProperties": false
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "file_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "detector_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "hdu_index": {
                                "type": "integer",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "file_id",
                              "detector_id",
                              "hdu_index"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "name",
                        "value",
                        "unit",
                        "status",
                        "reason",
                        "definition",
                        "sources"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "detector_id",
                  "measurements"
                ],
                "additionalProperties": false
              }
            },
            "summaries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "measurement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statistic": {
                    "enum": [
                      "mean",
                      "median"
                    ]
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "contributors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "not_measured": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "measurement",
                  "statistic",
                  "value",
                  "unit",
                  "contributors",
                  "not_measured"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "detectors",
            "summaries"
          ],
          "additionalProperties": false
        },
        "record": {
          "type": "object",
          "properties": {
            "schema_version": {
              "enum": [
                "1.0.0",
                "1.1.0"
              ]
            },
            "assessment_id": {
              "type": "string",
              "minLength": 1
            },
            "created_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schema_version",
            "assessment_id",
            "created_at"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "producer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "source_revision": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "version",
                "source_revision"
              ],
              "additionalProperties": false
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "configuration_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "producer",
            "operation",
            "configuration_id"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "file_id": {
                "type": "string",
                "minLength": 1
              },
              "qc": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "assessment_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "record_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "assessment_id",
                  "record_digest"
                ],
                "additionalProperties": false
              },
              "participation": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "used",
                      "rejected",
                      "not_used",
                      "pending"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "status",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "index",
              "file_id",
              "qc",
              "participation"
            ],
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "file",
        "characterization",
        "record",
        "provenance",
        "inputs",
        "extensions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "qc"
  ]
}
