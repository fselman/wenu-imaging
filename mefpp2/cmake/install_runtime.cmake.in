cmake_minimum_required(VERSION 3.29)
if(NOT "@MEFPP_BUILD_RESOURCES@")
  message(FATAL_ERROR "Runtime install requires MEFPP_BUILD_RESOURCES=ON and a complete resource build")
endif()
set(executable_record "@MEFPP_BINARY_DIR@/mefpp-path-${CMAKE_INSTALL_CONFIG_NAME}.cmake")
if(NOT EXISTS "${executable_record}")
  set(executable_record "@MEFPP_BINARY_DIR@/mefpp-path-.cmake")
endif()
include("${executable_record}")
set(sources "${MEFPP_EXECUTABLE}" "@MEFPP_SOURCE_DIR@/ins/mef/config/mefpp.paf" "@MEFPP_SOURCE_DIR@/ins/mef/config/omegacam.paf" "@MEFPP_SOURCE_DIR@/ins/mef/config/wfi.paf" "@MEFPP_BINARY_DIR@/resources/OCAM_BPM_1x1.fits" "@MEFPP_BINARY_DIR@/resources/WFI_BPM_1x1.fits" "@MEFPP_SOURCE_DIR@/LICENSE" "@MEFPP_SOURCE_DIR@/qfits5/LICENSE" "@MEFPP_BINARY_DIR@/source-sha256.txt")
set(destinations "bin/mefpp" "config/mefpp.paf" "config/omegacam.paf" "config/wfi.paf" "static_cal/OCAM_BPM_1x1.fits" "static_cal/WFI_BPM_1x1.fits" "share/mefpp/licenses/mefpp-LICENSE" "share/mefpp/licenses/qfits-LICENSE" "share/mefpp/source-sha256.txt")
set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
if(NOT IS_ABSOLUTE "${root}" OR root STREQUAL "/")
  message(FATAL_ERROR "Use an explicit private absolute installation prefix")
endif()
# Preflight: reject incomplete builds and conflicting files before copying anything.
file(READ "@MEFPP_BINARY_DIR@/build-info.json" manifest)
# Record the requested runtime prefix; DESTDIR remains an external staging root.
string(JSON manifest SET "${manifest}" install_prefix "\"${CMAKE_INSTALL_PREFIX}\"")
string(JSON manifest SET "${manifest}" installed_files "{}")
foreach(source destination IN ZIP_LISTS sources destinations)
  if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
    message(FATAL_ERROR "Required build product missing: ${source}; build before installing")
  endif()
  file(SHA256 "${source}" expected)
  string(JSON manifest SET "${manifest}" installed_files "${destination}" "\"${expected}\"")
  set(ancestor "${root}/${destination}")
  while(NOT ancestor STREQUAL "/" AND NOT ancestor STREQUAL "")
    if(IS_SYMLINK "${ancestor}")
      message(FATAL_ERROR "Refusing symlink installation path: ${ancestor}")
    endif()
    get_filename_component(ancestor "${ancestor}" DIRECTORY)
    if(EXISTS "${ancestor}" AND NOT IS_DIRECTORY "${ancestor}")
      message(FATAL_ERROR "Installation parent is not a directory: ${ancestor}")
    endif()
  endwhile()
  if(EXISTS "${root}/${destination}")
    if(IS_DIRECTORY "${root}/${destination}")
      message(FATAL_ERROR "File destination is a directory: ${root}/${destination}")
    endif()
    file(SHA256 "${root}/${destination}" actual)
    if(NOT expected STREQUAL actual)
      message(FATAL_ERROR "Preserving existing different file: ${root}/${destination}; use a fresh prefix")
    endif()
  endif()
endforeach()
set(manifest_path "${root}/share/mefpp/build-manifest.json")
if(EXISTS "${manifest_path}" OR IS_SYMLINK "${manifest_path}")
  if(IS_DIRECTORY "${manifest_path}" OR IS_SYMLINK "${manifest_path}")
    message(FATAL_ERROR "Refusing nonregular manifest destination")
  endif()
  file(READ "${manifest_path}" previous)
  if(NOT previous STREQUAL "${manifest}\n")
    message(FATAL_ERROR "Preserving existing different build manifest; use a fresh prefix")
  endif()
endif()
# Copy: only validated runtime files; COPY_FILE avoids implicit DESTDIR application twice.
foreach(source destination IN ZIP_LISTS sources destinations)
  get_filename_component(directory "${root}/${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(COPY_FILE "${source}" "${root}/${destination}" ONLY_IF_DIFFERENT)
  if(destination STREQUAL "bin/mefpp")
    file(CHMOD "${root}/${destination}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  endif()
endforeach()
file(WRITE "${manifest_path}" "${manifest}\n")
message(STATUS "Installed complete private runtime: ${root}")
